rules_version = '2';
// قواعد أمان Firestore لنظام الصرافة الذكي.
// فقط حسابات Google المذكورة بريدها هنا تستطيع القراءة والكتابة.
// إضافة شخص جديد = إضافة بريده إلى القائمة ثم Publish (بدون تغيير في الكود).
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{ws}/records/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "husseintaweel1@gmail.com"
        ];
    }
  }
}
